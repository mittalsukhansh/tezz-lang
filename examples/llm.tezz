-- This is an example of Tezz utilizing tezz-llm
-- We import the massive power of LangChain via a zero-config wrapper

import tezz_llm from "../packages/tezz-llm/index.js"
let askGemini = tezz_llm.askGemini
let askOpenAI = tezz_llm.askOpenAI

seva LLMService on 8080 {
  
  -- Route to talk to Gemini
  route POST "/ask-gemini" {
    rakho prompt = request.body.prompt
    if (!prompt) {
      jawab 400 { error: "prompt is required" }
      return
    }
    
    console.log("Asking Gemini: " + prompt)
    rakho response = await askGemini(prompt)
    
    jawab 200 { 
      model: "gemini-1.5-flash",
      answer: response 
    }
  }

  -- Route to talk to OpenAI
  route POST "/ask-openai" {
    rakho prompt = request.body.prompt
    if (!prompt) {
      jawab 400 { error: "prompt is required" }
      return
    }
    
    console.log("Asking GPT-3.5: " + prompt)
    rakho response = await askOpenAI(prompt)
    
    jawab 200 { 
      model: "gpt-3.5-turbo",
      answer: response 
    }
  }
}
